# Reloj y LEDs Go Board
set_io i_Clk 15
set_io o_LED[0] 56
set_io o_LED[1] 57
set_io o_LED[2] 59
set_io o_LED[3] 60

# SPI Slave: pines PMOD PS1..PS4 del PCF original
set_io i_SPI_CS_n 65
set_io i_SPI_MOSI 64
set_io o_SPI_MISO 63
set_io i_SPI_SCLK 62

# Maestro interno hacia PMOD libre PS7..PS9; retorno MISO por PS10
set_io o_TEST_SCLK 78
set_io o_TEST_MOSI 79
set_io o_TEST_CS_n 80
set_io i_TEST_MISO 81
